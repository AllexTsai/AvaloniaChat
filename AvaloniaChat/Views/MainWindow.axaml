<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AvaloniaChat.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="500"
        x:Class="AvaloniaChat.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Width="600" Height="500"
        Title="AvaloniaChat">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>

    <!-- 訊息泡泡的樣式在 Styles/ChatStyles.axaml，由 App.axaml 的 StyleInclude 引入 -->

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- 上方工具列：亮/暗切換（處理常式在 code-behind，因為這是純 View 的行為） -->
        <ToggleButton x:Name="ThemeToggle"
                      Grid.Row="0"
                      Margin="12,12,12,0"
                      HorizontalAlignment="Right"
                      Content="深色模式"
                      IsCheckedChanged="OnThemeToggleChanged" />

        <ScrollViewer x:Name="MessagesScrollViewer"
                      Grid.Row="1"
                      Padding="12">
            <ItemsControl ItemsSource="{Binding Messages}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ChatMessageViewModel">
                        <Border Classes="message"
                                Classes.user="{Binding IsUser}"
                                Classes.assistant="{Binding !IsUser}">
                            <StackPanel>
                                <TextBlock Text="{Binding Text}"
                                           TextWrapping="Wrap" />
                                <TextBlock Classes="stats"
                                           Text="{Binding Stats}"
                                           IsVisible="{Binding Stats, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Grid Grid.Row="2"
              ColumnDefinitions="*,Auto,Auto"
              Margin="12">
            <TextBox x:Name="InputTextBox"
                     Grid.Column="0"
                     Text="{Binding InputText}"
                     PlaceholderText="輸入訊息，按 Enter 送出">
                <TextBox.KeyBindings>
                    <KeyBinding Gesture="Enter" Command="{Binding SendCommand}" />
                </TextBox.KeyBindings>
            </TextBox>
            <Button x:Name="SendButton"
                    Grid.Column="1"
                    Margin="8,0,0,0"
                    Content="Send"
                    Command="{Binding SendCommand}" />
            <Button x:Name="CancelButton"
                    Grid.Column="2"
                    Margin="8,0,0,0"
                    Content="Cancel"
                    Command="{Binding CancelCommand}" />
        </Grid>

    </Grid>

</Window>
